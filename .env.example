# DWF — variables de entorno. En producción (Vercel) solo hace falta DATABASE_URL, y la carga sola
# la integración de Neon (ver README → Producción). En local no hace falta nada: usa una base embebida.

# Base de datos PostgreSQL de Neon (obligatoria en producción).
DATABASE_URL=

# Opcional: fija el secreto con el que se firma la sesión. Si no está, se genera y se guarda en la base.
# SESSION_SECRET=

# Opcional: apunta la app a otro backend de cotización (por defecto /api/dolar-blue).
# VITE_RATES_ENDPOINT=
